{
  "schemaVersion": 1,
  "region": "ap-beijing",
  "imagePrefix": "ccr.ccs.tencentyun.com/industrial-mcp-remote",
  "toolConfiguration": {
    "ToolType": "custom",
    "Persistent": false,
    "NetworkConfiguration": {
      "NetworkMode": "PUBLIC"
    },
    "CustomConfiguration": {
      "ImageRegistryType": "personal",
      "Command": [
        "/bin/bash",
        "-lc"
      ],
      "Args": [
        "/usr/bin/envd >/tmp/envd.log 2>&1 & exec python3 /opt/domain-packs/lib/worker-http.py"
      ],
      "Ports": [
        {
          "Name": "worker",
          "Port": 8080,
          "Protocol": "TCP"
        },
        {
          "Name": "envd",
          "Port": 49983,
          "Protocol": "TCP"
        }
      ],
      "Resources": {
        "CPU": "2",
        "Memory": "2Gi",
        "Storage": "10Gi"
      },
      "Probe": {
        "HttpGet": {
          "Path": "/health",
          "Port": 49983,
          "Scheme": "HTTP"
        },
        "ReadyTimeoutMs": 10000,
        "ProbeTimeoutMs": 1000,
        "ProbePeriodMs": 1000,
        "SuccessThreshold": 1,
        "FailureThreshold": 3
      }
    }
  }
}
