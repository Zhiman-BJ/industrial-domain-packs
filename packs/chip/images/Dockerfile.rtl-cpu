# syntax=docker/dockerfile:1
# Verilator's official fixed linux/amd64 image, also used by eda-full.
FROM verilator/verilator@sha256:4381a83fc2864cc2be91c5acb8ddff688077c73db20304b7f2c38cccd6a965da AS verilator
FROM ubuntu:24.04@sha256:008173c23f95b170204355c12626cb5a965d779a7e1283b09e9cffbb1bf33ca3
ARG DEBIAN_FRONTEND=noninteractive
# g++ and make are necessary at runtime to compile each simulation.
# Fixed Ubuntu binary releases; epochs are part of the version (g++, zlib1g).
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    apt-get -o Acquire::Retries=3 update && apt-get -o Acquire::Retries=3 install -y --no-install-recommends \
      g++=4:13.2.0-7ubuntu1 make=4.3-4.1build2 perl=5.38.2-3.2ubuntu0.6 ccache=4.9.1-1 \
      libfl2=2.6.4-8.2build1 zlib1g=1:1.3.dfsg-3.1ubuntu2.2 python3=3.12.3-0ubuntu2.1 \
      python3-venv=3.12.3-0ubuntu2.1 ca-certificates=20260601~24.04.1 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=verilator /usr/local/bin/verilator* /usr/local/bin/
COPY --from=verilator /usr/local/share/verilator /usr/local/share/verilator
COPY packs/chip/eda-harness/src/eda_harness/dependency_locks/runtime.txt /opt/locks/runtime.txt
RUN python3 -m venv /opt/venv && /opt/venv/bin/pip install --no-cache-dir --require-hashes --only-binary=:all: -r /opt/locks/runtime.txt
ENV PATH="/opt/venv/bin:${PATH}" HOME=/tmp PYTHONDONTWRITEBYTECODE=1 CCACHE_DISABLE=1
COPY package.json content-lock.json /opt/domain-packs/
COPY lib /opt/domain-packs/lib
COPY packs /opt/domain-packs/packs
RUN python3 /opt/domain-packs/packs/chip/runtime/native-profile.py /opt/domain-packs/packs/chip/examples/rtl /tmp/smoke \
    && test -s /tmp/smoke/wave.vcd && rm -rf /tmp/smoke
# The runtime identity this image agrees to serve; must match the server's
# pinned RuntimeProfile runtimeDigest (overridable per qualification build).
ARG CHIP_RUNTIME_DIGEST=sha256:ba6a3ccb431d95e01e29a0e363b8a8b4f077f7d2d08cc6f6c6e23277fb2e202b
ENV WORKER_RUNTIME_DIGEST=${CHIP_RUNTIME_DIGEST} WORKER_PACK=chip WORKER_PROFILE_ID=rtl-cpu
# AGS management daemon (binary only, from the public reference image):
# health checks, command execution, and the snapshot-staging file interface
# all flow through envd on 49983. Runs as the same fixed unprivileged user
# as the worker, so staged files land with matching ownership in /input.
COPY --from=ccr.ccs.tencentyun.com/ags-image/envd:v0.5.14 --chmod=755 /usr/bin/envd /usr/bin/envd
# /input receives the server-staged snapshot via the AGS file interface;
# /work holds per-request evidence directories. Both belong to the
# unprivileged runtime user (envd stages files as the boot user).
RUN mkdir -p /input /work/requests && chown -R 1000:1000 /input /work
EXPOSE 8080 49983
WORKDIR /work
USER 1000:1000
# Long-running narrow HTTP worker (POST /v1/worker/invoke); the trusted
# one-shot native-profile.py stays the executor it dispatches to. envd is
# brought up first per the AGS startup template.
ENTRYPOINT ["/bin/bash", "-l", "-c", "/usr/bin/envd > /tmp/envd.log 2>&1 & exec python3 /opt/domain-packs/lib/worker-http.py"]
