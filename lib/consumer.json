    {
      "id": "chip",
      "label": "Chip",
      "emoji": "💠",
      "version": "0.6.3",
      "summary": "EDA skills, viewers and the Chip MCP service",
      "prerequisites": [
        "Local RTL verification requires Python 3.13, Verilator and a C++ toolchain; prepare these separately",
        "Other EDA flows require their own tools, container images and PDK; installing this Pack does not install the complete EDA environment"
      ]
    },
    {
      "id": "pcb",
      "label": "PCB",
      "emoji": "🔌",
      "version": "0.3.4",
      "summary": "PCB design and repair on the pinned upstream atomic tool surface (89 tools) plus bounded native KiCad edits",
      "prerequisites": [
        "KiCad 10.0.6 and its bundled pcbnew Python are prepared automatically by a compatible Harness on Apple Silicon",
        "pcb.design.* container tools additionally need Docker with the image built from the vendored sources (Dockerfile.local-dev) and the gateway Python (uv sync --frozen --no-dev)"
      ],
      "qualifiedBundlePlatforms": [
        "darwin-arm64"
      ]
    },
    {
      "id": "godot",
      "label": "Godot",
      "emoji": "🎮",
      "version": "0.3.0",
      "summary": "Scene transforms, BoxMesh geometry, independent Godot structural verification and vendored GDScript/game-systems skills",
      "prerequisites": [
        "Godot 4.7.2 is prepared automatically by a compatible Harness on Apple Silicon; export templates are separate and not needed for the qualified structural task"
      ],
      "qualifiedBundlePlatforms": [
        "darwin-arm64"
      ]
    },
    {
      "id": "cad",
      "label": "CAD",
      "emoji": "📐",
      "version": "1.1.4-pack.10",
