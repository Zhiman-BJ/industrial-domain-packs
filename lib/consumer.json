      "qualifiedBundlePlatforms": [
        "darwin-arm64"
      ]
    },
    {
      "id": "cuda",
      "label": "CUDA",
      "emoji": "⚡",
      "version": "0.1.0",
      "summary": "Remote CUDA Compiler and RTX 4090 Evaluator MCP with kernel optimization Skill",
      "prerequisites": [
        "Developer configuration: both authenticated remote Compiler and Evaluator MCP services and a matching fixed reference model",
        "Remote clients need no local GPU; native service deployment and credentials are separate administrator prerequisites"
      ],
      "qualifiedBundlePlatforms": []
    }
